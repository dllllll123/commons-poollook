+      </section>
+      <section name="KeyedObjectPool 用法示例">
+       <p>
+        When you need to pool different categories or types of objects, a <code>KeyedObjectPool</code> is an
+        excellent choice. Instead of maintaining separate pools for each category, you can use a keyed pool
+        to manage all categories from a single pool instance. For example, if you need StringBuffers of
+        different initial capacities, you can use the capacity as the key and the keyed pool will maintain
+        separate sub-pools for each capacity.
+       </p>
+       <p>
+        Here's a <code>KeyedPooledObjectFactory</code> implementation that creates
+        <code>StringBuffer</code>s with different initial capacities keyed by the capacity value:
+       </p>
+<source>
+import org.apache.commons.pool3.BaseKeyedPooledObjectFactory;
+import org.apache.commons.pool3.PooledObject;
+import org.apache.commons.pool3.impl.DefaultPooledObject;
+
+public class KeyedStringBufferFactory
+    extends BaseKeyedPooledObjectFactory&lt;Integer, StringBuffer, RuntimeException&gt; {
+
+    @Override
+    public StringBuffer create(Integer initialCapacity) {
+        return new StringBuffer(initialCapacity);
+    }
+
+    /**
+     * Use the default PooledObject implementation.
+     */
+    @Override
+    public PooledObject&lt;StringBuffer&gt; wrap(StringBuffer buffer) {
+        return new DefaultPooledObject&lt;StringBuffer&gt;(buffer);
+    }
+
+    /**
+     * When an object is returned to the pool, clear the buffer.
+     */
+    @Override
+    public void passivateObject(Integer key, PooledObject&lt;StringBuffer&gt; pooledObject) {
+        pooledObject.getObject().setLength(0);
+    }
+
+    // for all other methods, the no-op implementation
+    // in BaseKeyedPooledObjectFactory will suffice
+}
+</source>
+       <p>
+        Here's the client code using the keyed pool:
+       </p>
+<source>
+import java.io.IOException;
+import java.io.Reader;
+import org.apache.commons.pool3.KeyedObjectPool;
+
+public class KeyedStringBufferUtil {
+
+    private KeyedObjectPool&lt;Integer, StringBuffer, ? extends Exception&gt; pool;
+
+    public KeyedStringBufferUtil(KeyedObjectPool&lt;Integer, StringBuffer, ? extends Exception&gt; pool) {
+        this.pool = pool;
+    }
+
+    /**
+     * Dumps the contents of the {@link Reader} to a String, using a StringBuffer
+     * with the specified initial capacity, closing the {@link Reader} when done.
+     */
+    public String readToString(Reader in, int initialCapacity)
+        throws IOException {
+        StringBuffer buf = null;
+        try {
+            buf = pool.borrowObject(initialCapacity);
+            for (int c = in.read(); c != -1; c = in.read()) {
+                buf.append((char) c);
+            }
+            return buf.toString();
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new RuntimeException("Unable to borrow buffer from pool" + e.toString());
+        } finally {
+            try {
+                in.close();
+            } catch (Exception e) {
+                // ignored
+            }
+            try {
+                if (null != buf) {
+                    pool.returnObject(initialCapacity, buf);
+                }
+            } catch (Exception e) {
+                // ignored
+            }
+        }
+    }
+}
+</source>
+      <p>
+       We can use this factory with the <code>GenericKeyedObjectPool</code> to instantiate our
+       <code>KeyedStringBufferUtil</code> and use different keys for different scenarios:
+      </p>
+<source>
+KeyedStringBufferUtil keyedUtil = new KeyedStringBufferUtil(
+    new GenericKeyedObjectPool<Integer, StringBuffer, RuntimeException>(new KeyedStringBufferFactory())
+);
+
+// Use small capacity for short string
+Reader shortReader = new StringReader("Hello World!");
+System.out.println("Short string: " + keyedUtil.readToString(shortReader, 16));
+
+// Use large capacity for longer string
+Reader longReader = new StringReader("This is a much longer string that benefits from a larger initial capacity.");
+System.out.println("Long string: " + keyedUtil.readToString(longReader, 128));
+</source>
